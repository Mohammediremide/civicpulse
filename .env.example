# CivicPulse — Environment Variables (Example)
# Copy to .env for local dev: cp .env.example .env
# On Vercel, add these under Project Settings → Environment Variables instead.
# Never commit your real .env file.

# ── Database (Vercel Postgres / Neon) ───────────────────────────────────────
# From Vercel: Storage → Create Database → Postgres (powered by Neon).
# Vercel injects these automatically once the DB is connected to this project,
# but you still need them locally for `npx prisma db push` / `db seed`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require&pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require

# ── Auth ─────────────────────────────────────────────────────────────────
# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# ── Geoapify (maps + geocoding) ─────────────────────────────────────────────
# Get a free key at https://www.geoapify.com/ → My Projects → API keys.
# Server-side only (used by /api/geocode.js) — keeps the key out of the bundle.
GEOAPIFY_API_KEY=replace-with-your-server-side-key
# Client-side (used to load map tiles directly in the browser). This one IS
# public/visible in the compiled JS — restrict it by domain in the Geoapify
# dashboard once you know your production URL.
VITE_GEOAPIFY_API_KEY=replace-with-your-client-side-key

# ── Frontend → API base URL ─────────────────────────────────────────────────
# Leave blank when deployed on Vercel — frontend and /api share the same
# domain automatically. Only set this if the API is hosted elsewhere.
VITE_API_BASE_URL=

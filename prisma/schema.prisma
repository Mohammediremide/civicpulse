// CivicPulse — Prisma schema
// Run `npx prisma migrate dev --name init` locally (or `npx prisma db push` for a
// quick first sync) once DATABASE_URL is set. See README for the full setup.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon/Vercel Postgres also give a non-pooled URL for migrations.
  directUrl = env("DIRECT_URL")
}

enum Role {
  citizen
  government_staff
  department_manager
  administrator
}

enum ComplaintType {
  community
  government
  consumer
}

enum Priority {
  Normal
  Medium
  High
  Critical
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(citizen)
  suspended    Boolean  @default(false)
  createdAt    DateTime @default(now())

  reports Report[]
}

model Report {
  id            String   @id @default(cuid())
  referenceId   String   @unique
  title         String
  description   String
  typeId        ComplaintType
  categoryId    String
  categoryLabel String
  priority      Priority @default(Medium)
  status        String   @default("Submitted")

  address String
  city    String
  state   String
  country String @default("Nigeria")
  lat     Float?
  lng     Float?

  department   String?
  organization String?

  evidence Json @default("[]")

  reporterId String?
  reporter   User?  @relation(fields: [reporterId], references: [id])
  reporterDisplayName String @default("Citizen")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeline TimelineEntry[]

  @@index([typeId])
  @@index([status])
  @@index([city])
}

model TimelineEntry {
  id        String   @id @default(cuid())
  status    String
  note      String
  timestamp DateTime @default(now())

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}
